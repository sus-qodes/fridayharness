{
  "$id": "urn:friday:protocol:v1:symbol.patch:params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "kind": {
      "type": "string",
      "enum": [
        "function",
        "class",
        "method",
        "field",
        "interface",
        "type",
        "enum",
        "variable",
        "namespace"
      ]
    },
    "line": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "path",
    "symbol",
    "body"
  ]
}
