{
  "$id": "urn:friday:protocol:v1:graph.blast_radius:params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "paths": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "symbols": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 700
      }
    },
    "diff": {
      "default": false,
      "type": "boolean"
    },
    "depth": {
      "default": 2,
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "names": {
      "default": false,
      "type": "boolean"
    }
  }
}
