{
  "$id": "urn:friday:protocol:v1:outbound:context.deliver",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "packet": {
      "type": "object",
      "properties": {
        "context_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "recipient": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "agent",
                "master_brain",
                "human"
              ]
            },
            "id": {
              "type": "string"
            },
            "harness_id": {
              "type": "string"
            },
            "run_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        "task_id": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "budget": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "latency_ms": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "chars": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tokens",
            "latency_ms"
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string"
                    },
                    "source_type": {
                      "type": "string",
                      "enum": [
                        "task_record",
                        "git",
                        "file",
                        "graph",
                        "memory",
                        "event",
                        "message",
                        "daemon"
                      ]
                    },
                    "authority": {
                      "type": "string"
                    },
                    "recency": {
                      "type": "string"
                    },
                    "relevance": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "relationship_distance": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "verification_status": {
                      "type": "string",
                      "enum": [
                        "verified",
                        "unverified",
                        "superseded"
                      ]
                    },
                    "selection_reason": {
                      "type": "string"
                    },
                    "estimated_tokens": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "source_id",
                    "source_type",
                    "authority",
                    "recency",
                    "relevance",
                    "relationship_distance",
                    "verification_status",
                    "selection_reason",
                    "estimated_tokens"
                  ]
                }
              },
              "authority": {
                "type": "string",
                "enum": [
                  "human",
                  "system",
                  "agent",
                  "task",
                  "git",
                  "memory",
                  "graph"
                ]
              }
            },
            "required": [
              "kind",
              "content",
              "sources",
              "authority"
            ]
          }
        },
        "staleness": {
          "type": "object",
          "properties": {
            "is_stale": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "is_stale"
          ]
        },
        "explain_uri": {
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "project_id",
        "recipient",
        "created_at",
        "state_version",
        "budget",
        "sections",
        "staleness"
      ]
    }
  },
  "required": [
    "task_id",
    "run_id",
    "packet"
  ]
}
