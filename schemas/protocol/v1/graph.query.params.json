{
  "$id": "urn:friday:protocol:v1:graph.query:params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "words": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "in_path": {
      "type": "string",
      "maxLength": 500
    },
    "prefix": {
      "type": "string",
      "maxLength": 500
    },
    "depth": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "kind": {
      "type": "string",
      "enum": [
        "symbol",
        "file"
      ]
    },
    "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  }
}
