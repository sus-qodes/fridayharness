{
  "$id": "urn:friday:protocol:v1:artifact.read:params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "artifact_ref": {
      "type": "string",
      "pattern": "^artifact:[A-Za-z0-9_-]+$"
    },
    "offset": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "limit": {
      "default": 200,
      "type": "integer",
      "minimum": 1,
      "maximum": 400
    },
    "find": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "col": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "artifact_ref"
  ]
}
