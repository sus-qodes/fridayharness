{
  "$id": "urn:friday:protocol:v1:agent.result:result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "READY",
        "ASSIGNED",
        "RUNNING",
        "WAITING",
        "READY_FOR_VERIFICATION",
        "VERIFYING",
        "COMPLETED",
        "FAILED",
        "REWORK",
        "HARNESS_LOST",
        "CANCELLED",
        "ABANDONED"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "NOT_REQUESTED",
        "QUEUED",
        "RUNNING",
        "PASSED",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "observed_changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "note"
        ]
      }
    }
  },
  "required": [
    "task_status",
    "verification_status",
    "observed_changed_paths",
    "discrepancies"
  ]
}
