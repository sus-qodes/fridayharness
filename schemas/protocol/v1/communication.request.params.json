{
  "$id": "urn:friday:protocol:v1:communication.request:params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "mode": {
      "type": "string",
      "enum": [
        "request",
        "response",
        "notification"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "response_to": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    }
  },
  "required": [
    "to",
    "mode",
    "content"
  ]
}
