{
  "$id": "urn:friday:protocol:v1:communication.request:params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "mode": {
      "type": "string",
      "enum": [
        "request",
        "response",
        "notification"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    },
    "facts": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "area": {
            "type": "string",
            "maxLength": 100
          },
          "impact": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "fact"
        ]
      }
    },
    "priority": {
      "default": "normal",
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "blocking": {
      "default": false,
      "type": "boolean"
    },
    "reply_within_s": {
      "type": "integer",
      "minimum": 10,
      "maximum": 604800
    },
    "response_to": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    }
  },
  "required": [
    "to",
    "mode",
    "content"
  ]
}
