{
  "$id": "urn:friday:protocol:v1:agent.error:params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "task_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "fatal": {
      "default": false,
      "type": "boolean"
    },
    "worker_stopped": {
      "type": "boolean"
    },
    "failure": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "start",
            "auth",
            "rate_limit",
            "transport",
            "timeout",
            "runtime_unavailable"
          ]
        },
        "retry_after_s": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 86400
        }
      },
      "required": [
        "kind"
      ]
    }
  },
  "required": [
    "task_id",
    "run_id",
    "message"
  ]
}
