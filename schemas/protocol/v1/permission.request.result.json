{
  "$id": "urn:friday:protocol:v1:permission.request:result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "granted",
        "denied"
      ]
    },
    "reason": {
      "type": "string"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "approval_id",
    "status",
    "reason",
    "expires_at"
  ]
}
