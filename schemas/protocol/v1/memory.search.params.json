{
  "$id": "urn:friday:protocol:v1:memory.search:params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "query": {
      "type": "string",
      "maxLength": 500
    },
    "kinds": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "decision",
          "architecture",
          "constraint",
          "convention",
          "bug-pattern",
          "dependency",
          "operational-runbook",
          "human-preference",
          "outcome",
          "learned-risk",
          "unresolved-question",
          "summary"
        ]
      }
    },
    "limit": {
      "default": 10,
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  }
}
