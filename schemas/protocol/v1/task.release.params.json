{
  "$id": "urn:friday:protocol:v1:task.release:params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "task_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "blocked",
        "handoff",
        "out_of_scope",
        "other"
      ]
    },
    "note": {
      "default": "",
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "task_id",
    "run_id",
    "reason"
  ]
}
