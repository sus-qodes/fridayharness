{
  "$id": "urn:friday:protocol:v1:task.update:result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "READY",
        "ASSIGNED",
        "RUNNING",
        "WAITING",
        "READY_FOR_VERIFICATION",
        "VERIFYING",
        "COMPLETED",
        "FAILED",
        "REWORK",
        "HARNESS_LOST",
        "CANCELLED",
        "ABANDONED"
      ]
    },
    "event_id": {
      "type": "string"
    }
  },
  "required": [
    "task_status",
    "event_id"
  ]
}
