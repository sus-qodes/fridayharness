{
  "$id": "urn:friday:protocol:v1:operation.status:params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation_run_id": {
      "type": "string",
      "minLength": 1
    },
    "wait_ms": {
      "default": 20000,
      "type": "integer",
      "minimum": 0,
      "maximum": 25000
    }
  },
  "required": [
    "operation_run_id"
  ]
}
