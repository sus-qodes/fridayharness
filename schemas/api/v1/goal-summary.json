{
  "$id": "urn:friday:api:v1:goal-summary",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tasks": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "verified": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "verified"
      ]
    },
    "claims_refused": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "reworked": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "held_for_human": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "refused_by_policy": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "sessions_lost": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "sessions_recovered": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "hosts": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "reported": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens_reporters": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "cost_reporters": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "attempts",
        "reported",
        "tokens",
        "tokens_reporters",
        "cost_usd",
        "cost_reporters"
      ]
    },
    "planning": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "unknown_cost_calls": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "calls",
        "cost_usd",
        "unknown_cost_calls"
      ]
    }
  },
  "required": [
    "tasks",
    "claims_refused",
    "reworked",
    "held_for_human",
    "refused_by_policy",
    "sessions_lost",
    "sessions_recovered",
    "hosts",
    "planning"
  ]
}
