{
  "$id": "urn:friday:api:v1:human-message-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reply_to": {
      "type": "string"
    },
    "priority": {
      "default": "normal",
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    }
  },
  "required": [
    "to",
    "content"
  ]
}
