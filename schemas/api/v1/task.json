{
  "$id": "urn:friday:api:v1:task",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "goal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_version": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_key": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "role_source": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "plan",
            "task",
            "human",
            "decision_model",
            "kind_fallback",
            "path_fallback",
            "missing",
            "none"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "role_confidence": {
      "default": null,
      "type": [
        "number",
        "null"
      ]
    },
    "role_decision_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "role_intent_version": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "role_registry_version": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "implementation",
        "verification",
        "review",
        "research",
        "docs",
        "chore"
      ]
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "READY",
        "ASSIGNED",
        "RUNNING",
        "WAITING",
        "READY_FOR_VERIFICATION",
        "VERIFYING",
        "COMPLETED",
        "FAILED",
        "REWORK",
        "HARNESS_LOST",
        "CANCELLED",
        "ABANDONED"
      ]
    },
    "waiting_reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "blocked",
            "context_required",
            "human_approval",
            "dependency_wait",
            "agent_error"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "scope": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "write": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "read": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reserved_for_agent_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "reserved_by": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "human",
            "master_brain",
            "rework"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reserved_until": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "assigned_agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "assigned_harness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_by": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "system",
            "agent",
            "harness",
            "master_brain"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancelled_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "task_id",
    "project_id",
    "goal_id",
    "plan_id",
    "kind",
    "summary",
    "description",
    "acceptance_criteria",
    "status",
    "waiting_reason",
    "priority",
    "risk_level",
    "scope",
    "dependencies",
    "reserved_for_agent_key",
    "assigned_agent_id",
    "assigned_harness_id",
    "current_run_id",
    "created_by",
    "created_at",
    "updated_at",
    "started_at",
    "completed_at",
    "cancelled_at",
    "revision"
  ]
}
