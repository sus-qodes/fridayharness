{
  "$id": "urn:friday:api:v1:verification",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verification_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_REQUESTED",
        "QUEUED",
        "RUNNING",
        "PASSED",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_root": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "tree": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "NOT_REQUESTED",
              "QUEUED",
              "RUNNING",
              "PASSED",
              "FAILED",
              "BLOCKED",
              "CANCELLED"
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "artifact_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "origin": {
            "type": "string",
            "enum": [
              "friday",
              "configured",
              "targeted"
            ]
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "details": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "findings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rule": {
                          "type": "string"
                        },
                        "severity": {
                          "type": "string",
                          "enum": [
                            "fail",
                            "warn",
                            "info"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "paths": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "rule",
                        "severity",
                        "message",
                        "paths"
                      ]
                    }
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "status",
          "exit_code",
          "artifact_ref",
          "summary",
          "required",
          "origin",
          "duration_ms",
          "details"
        ]
      }
    }
  },
  "required": [
    "verification_id",
    "task_id",
    "run_id",
    "status",
    "started_at",
    "ended_at",
    "summary",
    "execution_root",
    "commit_sha",
    "source_version",
    "base_commit",
    "task_kind",
    "checks"
  ]
}
