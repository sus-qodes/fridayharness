{
  "$id": "urn:friday:api:v1:project-intent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "objective": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "enum": [
              "human",
              "planner"
            ]
          },
          "from_paths": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "required": [
          "text",
          "source"
        ]
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "enum": [
              "human",
              "planner"
            ]
          },
          "from_paths": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "required": [
          "text",
          "source"
        ]
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "enum": [
              "human",
              "planner"
            ]
          },
          "from_paths": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "required": [
          "text",
          "source"
        ]
      }
    },
    "definition_of_done": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "enum": [
              "human",
              "planner"
            ]
          },
          "from_paths": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "required": [
          "text",
          "source"
        ]
      }
    },
    "content_hash": {
      "type": "string"
    },
    "proposed_by": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "system",
            "agent",
            "harness",
            "master_brain"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "system",
                "agent",
                "harness",
                "master_brain"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "project_id",
    "version",
    "status",
    "objective",
    "constraints",
    "outcomes",
    "non_goals",
    "definition_of_done",
    "content_hash",
    "proposed_by",
    "decided_by",
    "decision_note",
    "created_at",
    "decided_at"
  ]
}
