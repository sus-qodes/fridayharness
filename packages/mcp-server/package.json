{
  "name": "@friday/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "The friday stdio MCP server: tools, resources, prompts and reusable tool handlers.",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@friday/adapter-generic": "workspace:*",
    "@friday/protocol": "workspace:*",
    "@friday/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@friday/test-support": "workspace:*"
  },
  "bin": {
    "friday-mcp": "./bin/friday-mcp.mjs"
  }
}
