{
  "name": "@friday/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Daemon discovery, HTTP and RPC client, SSE and long-poll parsing.",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sse": {
      "development": "./src/sse.ts",
      "types": "./dist/sse.d.ts",
      "default": "./dist/sse.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@friday/protocol": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@friday/test-support": "workspace:*"
  }
}
