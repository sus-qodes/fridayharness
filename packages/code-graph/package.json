{
  "name": "@friday/code-graph",
  "version": "0.0.0",
  "private": true,
  "description": "File-level code graph of an execution root: imports, consumers, tests and shared contracts (tree-sitter WASM).",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@friday/db": "workspace:*",
    "@friday/git": "workspace:*",
    "@friday/protocol": "workspace:*",
    "@vscode/tree-sitter-wasm": "0.3.1"
  },
  "devDependencies": {
    "@friday/test-support": "workspace:*"
  }
}
