{
  "name": "@friday/adapter-opencode",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental OpenCode controlled no-model launcher and policy plugin (checkpoints A/B).",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@friday/adapter-claude": "workspace:*",
    "@friday/adapter-generic": "workspace:*",
    "@friday/execution": "workspace:*",
    "@friday/protocol": "workspace:*",
    "@friday/sdk": "workspace:*"
  },
  "devDependencies": {
    "@friday/test-support": "workspace:*"
  }
}
