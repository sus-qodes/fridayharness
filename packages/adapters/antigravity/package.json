{
  "name": "@friday/adapter-antigravity",
  "version": "0.0.0",
  "private": true,
  "description": "Antigravity adapter (experimental, attach only): writes Friday's hooks, the friday MCP server and the AGENTS.md block into a project, and checks them with a doctor.",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@friday/adapter-claude": "workspace:*",
    "@friday/protocol": "workspace:*",
    "@friday/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@friday/test-support": "workspace:*"
  }
}
