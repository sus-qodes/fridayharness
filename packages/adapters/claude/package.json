{
  "name": "@friday/adapter-claude",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code adapter: hook launcher and router, host configurator, and spawn mode driving the installed Claude Code headless.",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/bundle-hook.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@friday/adapter-generic": "workspace:*",
    "@friday/daemon": "workspace:*",
    "@friday/execution": "workspace:*",
    "@friday/git": "workspace:*",
    "@friday/mcp-server": "workspace:*",
    "@friday/policy": "workspace:*",
    "@friday/protocol": "workspace:*",
    "@friday/sdk": "workspace:*",
    "@friday/state": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@friday/test-support": "workspace:*",
    "esbuild": "~0.28.0",
    "yaml": "^2.9.1"
  }
}
