{
  "name": "@friday/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The friday command-line interface.",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@friday/adapter-antigravity": "workspace:*",
    "@friday/adapter-claude": "workspace:*",
    "@friday/adapter-codex": "workspace:*",
    "@friday/adapter-cursor": "workspace:*",
    "@friday/adapter-gemini": "workspace:*",
    "@friday/adapter-opencode": "workspace:*",
    "@friday/daemon": "workspace:*",
    "@friday/db": "workspace:*",
    "@friday/git": "workspace:*",
    "@friday/protocol": "workspace:*",
    "@friday/routing": "workspace:*",
    "@friday/sdk": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "bin": {
    "friday": "./bin/friday.mjs"
  }
}
